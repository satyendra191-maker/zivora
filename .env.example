# Copy to .env.local for local development. Never commit real secrets.
# This file must stay placeholder-only. Put real values in .env.local (untracked).
# Database (required at runtime; `next build` works without it)
DATABASE_URL=postgresql://user:password@localhost:5432/app_db
# Public site origin for absolute sharing metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Google OAuth via Supabase (email auth always works without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Alternative key name also accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
