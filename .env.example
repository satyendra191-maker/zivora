# Copy to .env.local for local development. Never commit real secrets.
# This file must stay placeholder-only. Put real values in .env.local (untracked).
# Database (required at runtime; `next build` works without it)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Public site origin for absolute sharing metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Google OAuth via Supabase (email auth always works without these)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-PUBLISHABLE-KEY]
# Alternative key name also accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
